{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for automated dependency management and security updates",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":enablePreCommit",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "timezone": "UTC",
  "schedule": [
    "before 10am on monday"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "packageRules": [
    {
      "description": "Automatically merge minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Security vulnerability updates - high priority",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "labels": [
        "security",
        "dependencies"
      ],
      "automerge": true,
      "prPriority": 10
    },
    {
      "description": "Group React and React DOM updates together",
      "matchPackagePatterns": [
        "^react",
        "^@types/react"
      ],
      "groupName": "React"
    },
    {
      "description": "Group ethers.js related packages",
      "matchPackagePatterns": [
        "ethers",
        "@ethersproject"
      ],
      "groupName": "Ethers"
    },
    {
      "description": "Group Hardhat related packages",
      "matchPackagePatterns": [
        "hardhat",
        "@nomicfoundation"
      ],
      "groupName": "Hardhat"
    },
    {
      "description": "Separate major updates for manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "description": "High priority for critical security updates",
      "matchDatasources": [
        "npm",
        "pypi"
      ],
      "vulnerabilityAlerts": {
        "labels": [
          "security",
          "critical"
        ],
        "automerge": true,
        "prPriority": 20
      }
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "automerge": true,
    "prPriority": 20
  },
  "npm": {
    "minimumReleaseAge": "3 days"
  },
  "pip_requirements": {
    "fileMatch": [
      "(^|/)requirements\\.txt$"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 10am on the first day of the month"
    ]
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "ignoreDeps": [],
  "commitMessagePrefix": "chore(deps):",
  "semanticCommits": "enabled"
}
