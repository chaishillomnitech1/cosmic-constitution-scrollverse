{
  "dashboard": {
    "name": "Phase 3-7 Manus Analytics Dashboard",
    "version": "3.7.0",
    "description": "Real-time analytics for autonomous quantum AI and zkEVM governance",
    "refreshInterval": 2000,
    "timezone": "UTC"
  },
  "dataSources": {
    "quantumAI": {
      "enabled": true,
      "endpoint": "/api/analytics/quantum-ai",
      "metrics": [
        "selfHealingOps",
        "autonomousProtocolHealth",
        "aiNodeStatus",
        "quantumCoherence"
      ]
    },
    "zkEVM": {
      "enabled": true,
      "endpoint": "/api/analytics/zkevm-governance",
      "metrics": [
        "governanceOutputs",
        "layerZTransactions",
        "immutableRecords",
        "daoNodeSync"
      ]
    },
    "staking": {
      "enabled": true,
      "endpoint": "/api/analytics/medair-staking",
      "metrics": [
        "totalStaked",
        "activeStakers",
        "rewardDistribution",
        "stakingAPY"
      ]
    },
    "compatibility": {
      "enabled": true,
      "endpoint": "/api/analytics/sigil-compatibility",
      "metrics": [
        "sigilProcessing",
        "compatibilityScore",
        "integrationHealth",
        "crossChainOps"
      ]
    }
  },
  "visualization": {
    "charts": [
      {
        "id": "quantum-ai-health",
        "type": "line",
        "title": "Quantum AI Protocol Health",
        "dataSource": "quantumAI",
        "metric": "autonomousProtocolHealth",
        "updateInterval": 2000
      },
      {
        "id": "zkevm-outputs",
        "type": "bar",
        "title": "Layer-Z Governance Outputs",
        "dataSource": "zkEVM",
        "metric": "governanceOutputs",
        "updateInterval": 5000
      },
      {
        "id": "staking-overview",
        "type": "gauge",
        "title": "$MEDAIR Staking Analytics",
        "dataSource": "staking",
        "metric": "totalStaked",
        "updateInterval": 10000
      },
      {
        "id": "sigil-compatibility",
        "type": "line",
        "title": "$SIGIL Compatibility Processing",
        "dataSource": "compatibility",
        "metric": "compatibilityScore",
        "updateInterval": 3000
      }
    ]
  },
  "alerts": {
    "enabled": true,
    "thresholds": {
      "quantumCoherence": {
        "min": 0.95,
        "alertLevel": "critical"
      },
      "autonomousProtocolHealth": {
        "min": 0.90,
        "alertLevel": "warning"
      },
      "daoNodeSync": {
        "min": 0.98,
        "alertLevel": "critical"
      }
    }
  },
  "security": {
    "pqc": {
      "enabled": true,
      "algorithm": "FALCON-SPHINCS+",
      "keySize": 512
    },
    "immutableSafeguards": true,
    "rogueAIProtection": true
  }
}
