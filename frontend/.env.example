# WalletConnect Project ID (get from https://cloud.walletconnect.com)
REACT_APP_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Contract Addresses (deployed contracts)
REACT_APP_NFT_CONTRACT_ADDRESS=
REACT_APP_MULTI_TOKEN_CONTRACT_ADDRESS=
REACT_APP_DAO_CONTRACT_ADDRESS=
REACT_APP_QUEENS_SOVEREIGNTY_CONTRACT_ADDRESS=
REACT_APP_MEDAIR_ORACLE_CONTRACT_ADDRESS=

# RPC URLs
REACT_APP_ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
REACT_APP_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
REACT_APP_POLYGON_RPC_URL=https://polygon-rpc.com
REACT_APP_MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_API_KEY

# IPFS Configuration
REACT_APP_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Enable testnets
REACT_APP_ENABLE_TESTNETS=true

# API Backend URL
REACT_APP_API_URL=http://localhost:3001/api
